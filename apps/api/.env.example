# CodePilot Web 运行时模型配置模板（入库，可安全提交）。
# ─────────────────────────────────────────────────────────────
# 用途：C2 ClaudeSdkRuntimeAdapter 的 query() options.env，以及集成/E2E 测试运行时读取。
# 用法：把本文件复制为同目录下的 `.env`（`cp apps/api/.env.example apps/api/.env`），
#       再填入真实 ANTHROPIC_AUTH_TOKEN。`.env` 已被 .gitignore 排除，绝不入库。
#
# 铁律：
#   - 密钥（ANTHROPIC_AUTH_TOKEN）只写进 .env，绝不写进本模板、绝不入库、绝不回显。
#   - 这些值由 apps/api 适配层（C2 SDK 适配器 / E2E 测试）在运行时读取；
#     核心包 packages/core 零框架、禁 @anthropic-ai/*、禁读 process.env（见 check-core-imports.mjs）。
#   - 不注入 workflow 子代理——子代理继承会话模型，由会话启动时的环境决定，改不了在跑的会话。

# Claude Code / SDK 行为开关
CLAUDE_CODE_WORKFLOWS=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# litellm 代理与模型（本机集成/E2E 走 litellm 网关，统一路由到 Jereh-Kimi-K2.6）
ANTHROPIC_BASE_URL=https://litellm.jereh.cn
ANTHROPIC_MODEL=Jereh-Kimi-K2.6
CLAUDE_CODE_SUBAGENT_MODEL=Jereh-Kimi-K2.6
ANTHROPIC_DEFAULT_OPUS_MODEL=Jereh-Kimi-K2.6
ANTHROPIC_DEFAULT_SONNET_MODEL=Jereh-Kimi-K2.6
ANTHROPIC_DEFAULT_HAIKU_MODEL=Jereh-Kimi-K2.6

# 密钥：复制为 .env 后填真实值，形如 sk-xxxxxxxx。切勿在本模板里填真实 token。
ANTHROPIC_AUTH_TOKEN=sk-REPLACE_ME
